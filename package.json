{
  "name": "swarmship",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check:files": "node scripts/check-source-size.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "dev": "pnpm --parallel --filter @swarmship/web --filter @swarmship/server --filter @swarmship/worker dev",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,tsx,json}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \".github/**/*.yml\" \"playwright.config.ts\" \"*.{json,yaml,yml}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,tsx,json}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \".github/**/*.yml\" \"playwright.config.ts\" \"*.{json,yaml,yml}\"",
    "lint": "oxlint --deny-warnings apps packages tests scripts playwright.config.ts",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:files && pnpm check:secrets"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/node": "24.13.3",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
