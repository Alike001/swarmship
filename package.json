{
  "name": "swarmship",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm build:apps && pnpm contract:build",
    "build:apps": "pnpm -r --if-present build",
    "check:files": "node scripts/check-source-size.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "contract:build": "cargo build --release --target wasm32-unknown-unknown --workspace",
    "contract:format": "cargo fmt --all",
    "contract:format:check": "cargo fmt --all -- --check",
    "contract:lint": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "contract:stylus": "cargo stylus check --contract agent-task-registry --endpoint https://sepolia-rollup.arbitrum.io/rpc",
    "contract:test": "cargo test --workspace --all-features",
    "dev": "pnpm --parallel --filter @swarmship/web --filter @swarmship/server --filter @swarmship/worker dev",
    "db:test:down": "docker compose -f infra/compose.test.yml down",
    "db:test:up": "docker compose -f infra/compose.test.yml up -d --wait",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,tsx,json}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \".github/**/*.yml\" \"playwright.config.ts\" \"*.{json,yaml,yml}\" && pnpm contract:format",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,tsx,json}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \".github/**/*.yml\" \"playwright.config.ts\" \"*.{json,yaml,yml}\" && pnpm contract:format:check",
    "lint": "oxlint --deny-warnings apps packages tests scripts playwright.config.ts && pnpm contract:lint",
    "test": "pnpm test:apps && pnpm contract:test",
    "test:apps": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:files && pnpm check:secrets"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/node": "24.13.3",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "viem": "2.55.19",
    "vitest": "4.1.11"
  }
}
