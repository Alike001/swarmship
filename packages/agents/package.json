    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@openai/agents": "0.17.0",
    "@swarmship/domain": "workspace:^",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsx": "4.23.12"
  }
}
